# ---------------------------------------------------------------------------
# VeChain blockchain integrity anchor - environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# SIGNING STRATEGY: configure exactly ONE of VECHAIN_PRIVATE_KEY or
# VECHAIN_MNEMONIC. Setting both is an error and hardhat.config.ts will refuse
# to start. Use .env for local development only; production must migrate to a
# Secret Manager / HSM / Vault / secure signer WITHOUT changing the contract.
#
# VeChain dual-token model:
#   VET  -> account / network asset (value transfer)
#   VTHO -> transaction gas cost (energy). The anchor wallet must hold VTHO.
#
# Testnet faucet: https://faucet.vecha.in  (testnet VET/VTHO only)
# ---------------------------------------------------------------------------

# Target network for scripts: vechain_solo | vechain_testnet | vechain_mainnet
VECHAIN_NETWORK=vechain_testnet

# Per-network RPC (do not point Testnet at 127.0.0.1:8669)
VECHAIN_TESTNET_RPC_URL=https://testnet.vechain.org
VECHAIN_MAINNET_RPC_URL=https://mainnet.vechain.org
THOR_SOLO_URL=http://127.0.0.1:8669

# --- Signing strategy (choose exactly ONE) ---------------------------------
# Required for vechain_testnet deploy and npm run test:e2e:testnet
VECHAIN_MNEMONIC=
VECHAIN_PRIVATE_KEY=

# Chain ID (informational; the plugin resolves it per network):
#   vechain_solo     24652929101810
#   vechain_testnet  100010
#   vechain_mainnet  100009
VECHAIN_CHAIN_ID=100010

# Deployed BatchIntegrityAnchor address (reuse on Testnet E2E after first deploy)
ANCHOR_CONTRACT_ADDRESS=
BATCH_INTEGRITY_ANCHOR_ADDRESS=

# --- Fee delegation (optional, adapter-level only) -------------------------
FEE_DELEGATION_ENABLED=false
FEE_DELEGATION_URL=

# --- Off-chain metadata storage ---------------------------------------------
# Default: local JSON under deployments/ (NO PostgreSQL required).
#   deployments/integrity-reports/   ← check:gs1-flow
#   deployments/anchor-records/      ← anchor:batch
#   deployments/vechain_testnet.json ← deploy:testnet
#
# PostgreSQL indexer is OPTIONAL and unused by the default Testnet path.
# INDEXER_DATABASE_URL=

# --- Deployment parameters -------------------------------------------------
DEPLOYMENT_ADMIN_ADDRESS=

# Anchor wallet that receives ANCHOR_ROLE (scripts/configure-roles.ts)
ANCHOR_WALLET_ADDRESS=
ROLE_OPERATION=check
